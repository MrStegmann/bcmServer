# ==========================================
# bcmServer Environment Configuration Template
# ==========================================

# Server Configuration
SERVER_PORT=8080
SPRING_PROFILES_ACTIVE=dev

# PostgreSQL Database Configuration (Default: Local Docker PostgreSQL)
DB_HOST=localhost
DB_PORT=5432
DB_NAME=bcm_db
DB_USERNAME=postgres
DB_PASSWORD=postgres
DB_QUERY_PARAMS=

# -----------------------------------------------------------------------------
# Supabase Database Configuration:
#
# Option 1: Supabase Pooler (Recommended for IPv4 networks & connection pooling)
#   DB_HOST=aws-0-[region].pooler.supabase.com  (e.g., aws-0-eu-central-1.pooler.supabase.com)
#   DB_PORT=6543 (transaction mode) or 5432 (session mode)
#   DB_NAME=postgres
#   DB_USERNAME=postgres.[project-ref]          (e.g., postgres.ccthgmjmkdxhpqovbbvk)
#   DB_PASSWORD=[your-password]
#   DB_QUERY_PARAMS=?sslmode=require
#
# Option 2: Direct Connection (Requires IPv6 network routing)
#   DB_HOST=db.[project-ref].supabase.co        (e.g., db.ccthgmjmkdxhpqovbbvk.supabase.co)
#   DB_PORT=5432
#   DB_NAME=postgres
#   DB_USERNAME=postgres
#   DB_PASSWORD=[your-password]
#   DB_QUERY_PARAMS=?sslmode=require
#
# Option 3: Full JDBC URL Override (if set, overrides DB_HOST, DB_PORT, DB_NAME, DB_QUERY_PARAMS)
#   DB_URL=jdbc:postgresql://aws-0-eu-central-1.pooler.supabase.com:6543/postgres?sslmode=require
# -----------------------------------------------------------------------------
